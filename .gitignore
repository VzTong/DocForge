*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
.installed.cfg
*.log
*.pot
*.mo
*.coverage
.coverage.*
.cache/
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.tox/
.env/
venv/
ENV/
env/
*.ipynb_checkpoints

# -------------------------
# Vue.js / Node.js
# -------------------------
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
.pnpm-lock.yaml

# Vue CLI / Vite
/.cache/
.cache/
.vite/
vite.config.ts.timestamp-*
coverage/
*.local
*.sourcemap
*.gz
*.br

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Docker
# -------------------------
# Ignore Docker build artifacts
Dockerfile.*
docker-compose.override.yml
.docker/
.dockerignore
**/.docker-temp/
**/.docker-build/

# -------------------------
# CI/CD
# -------------------------
# GitHub Actions
.github/workflows/*.tmp
.github/workflows/*.bak

# Azure Pipelines
.azure-pipelines.yml
azure-pipelines.*.yml
*.azure-pipelines/

# General CI/CD logs
ci.log
ci-temp/
ci-cache/
