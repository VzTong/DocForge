<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <title>{{ title }}</title>
        <style>{{ css }}</style>
    </head>
    <body>
        <div class="cv-container">
            <header class="cv-header">
                <h1>{{ title }}</h1>
                {% if subtitle_html %}<div class="cv-subtitle">{{ subtitle_html | safe }}</div>{% endif %}
                {% if contact_html %}<div class="cv-contact">{{ contact_html | safe }}</div>{% endif %}
                {% if address_html %}<div class="cv-contact cv-address">{{ address_html | safe }}</div>{% endif %}
                {% if links_html %}<div class="cv-contact cv-links">{{ links_html | safe }}</div>{% endif %}
            </header>
            <main class="cv-body">
                {{ body }}
            </main>
        </div>
    </body>
</html>
