# Local environment values for DocForge_PyService
# Copy from .env.example and adjust for your machine.
DEBUG=your_debug_value_here

# Giới hạn dung lượng upload file (bytes)
MAX_FILE_SIZE=your_max_file_size_here
MAX_AUDIO_SIZE=your_max_audio_size_here

# Groq API settings
# TRANSCRIBER_ENGINE=groq
GROQ_API_KEY=your_api_key_here
GROQ_MAX_BYTES=your_max_bytes_here
GROQ_MODEL=your_model_here